---
import { getShopInfo, unwrapOrThrow } from "../../api";

import Base from "../../layouts/Base.astro";

import "./contact.css";

const shopInfo = unwrapOrThrow(await getShopInfo().andTee(({ cacheHint }) => Astro.cache.set(cacheHint))).entry.data;
---

<Base title="お問い合わせ完了｜ねこと白鳥-CAFÉ&BAR" pageName="contact" navbarOffset={80} noindex>
  <div style="background: linear-gradient(0deg, rgba(106,65,19,1) 0%, rgba(192,160,105,1) 100%);">
    <section class="page-header">
      <div class="container">
        <div class="row justify-content-center">
          <div class="col-lg-7 col-md-9">
            <div class="text-center" style="margin-top: 140px; margin-bottom: 20px;"></div>
          </div>
        </div>
      </div>
    </section>

    <section style="background: none;">
      <div class="container">
        <div class="row justify-content-center align-items-center">
          <div class="col-md-10 p-3 p-sm-5">
            <div class="contact-thanks-card">
              <h2 style="text-align: center;">
                <span
                  class="d-none d-md-inline-block"
                  style="font-size: 28px; font-weight: 700; margin-bottom: 1.25rem;"
                >
                  送信完了
                </span>
                <span class="d-inline-block d-md-none" style="font-size: 22px; font-weight: 700; margin-bottom: 1rem;">
                  送信完了
                </span>
              </h2>
              <p
                class="text-white sans-serif"
                style="color: #ffffff; font-size: 14px; font-weight: 400; text-align: left;"
              >
                お問い合わせありがとうございます。
                <br>
                お送り頂きました内容を確認の上、2営業日以内に折り返しご連絡させて頂きます。また、ご記入頂いたメールアドレスへ、自動返信の確認メールをお送りしております。
                <br>
                <br>
                しばらく経ってもメールが届かない場合は、入力頂いたメールアドレスが間違っているか、迷惑メールフォルダに振り分けられている可能性がございます。
                <br>
                以上の内容をご確認の上、お手数ですがもう一度フォームよりお問い合わせ頂きますようお願い申し上げます。
                <br>
                <br>
                なお、お急ぎの場合は電話でもお問い合わせを受け付けております。TEL.
                <a href={`tel:${shopInfo.tel_no}`}>{shopInfo.tel}</a>
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
.contact-thanks-card {
  width: 100%;
  height: auto;
  background: #ffffff25;
  border-radius: 4px;
  padding: 1.5rem 1rem;
  margin-bottom: 1.5rem;
}

@media screen and (min-width: 576px) {
  .contact-thanks-card {
    padding: 2rem 2rem 2.5rem 2rem;
  }
}
</style>
