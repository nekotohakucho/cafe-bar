---
import type { Menu, MenuItem } from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { ResultAsync } from "neverthrow";

import paceUrl from "pace-js/pace.min.js?url";

import { getMenu, getShopInfo, unwrapOrThrow } from "../api";
import type { NavItem } from "../components/navbar/navbar.astro";

import styles from "../styles/index.css?url";

import Navbar from "../components/navbar/navbar.astro";
import Footer from "../components/footer/footer.astro";
import ScrollToTop from "../components/scroll-to-top/scroll-to-top.astro";
import Cursor from "../components/cursor/cursor.astro";
import LoadingScreen from "../components/landing-screen/loading-screen.astro";

const toNavItem =
  (isLowerPage: boolean) =>
  (item: MenuItem): NavItem => {
    const isAnchor = item.url.startsWith("/#");
    const inPageAnchor = isAnchor && !isLowerPage;

    return {
      label: item.label,
      href: inPageAnchor ? item.url.slice(1) : item.url,
      classNames: [item.cssClasses, inPageAnchor ? "scroll-link" : undefined].filter((c) => c !== undefined),
      target: item.target,
      children: item.children.map(toNavItem(isLowerPage)),
    };
  };

const toNavItems = (isLowerPage: boolean) => (menu: Menu) => menu.items.map(toNavItem(isLowerPage));

interface Props {
  title: string;
  description?: string | null;
  noindex?: boolean;
  canonical?: string | null;
  image?: string | null;
  pageName?: string;
  navbarOffset?: number;
  content?: { collection: string; id: string; slug?: string | null };
}

const {
  title,
  description,
  noindex = false,
  canonical,
  image,
  content,
  pageName = "",
  navbarOffset = 300,
} = Astro.props;

const isLowerPage = pageName !== "top";

const [menus, shopInfo] = unwrapOrThrow(
  await ResultAsync.combine([
    getMenu("primary").map(toNavItems(isLowerPage)),
    getShopInfo()
      .andTee(({ cacheHint }) => Astro.cache.set(cacheHint))
      .map(({ entry }) => entry.data),
  ]),
);

const pageCtx = createPublicPageContext({
  Astro,
  kind: content ? "content" : "custom",
  pageType: "website",
  title,
  description,
  canonical,
  image,
  content,
});
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style is:inline>
      @layer theme, reset, vendor, base, components, page, utilities;
    </style>
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>{title}</title>
    <link rel="shortcut icon" href="/favicon.ico">
    <link rel="apple-touch-icon" type="image/png" href="/apple-touch-icon-180x180.png">
    <link rel="icon" type="image/png" href="/icon-192x192.png">

    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}

    <link
      href="https://fonts.googleapis.com/css?family=Poppins:100,200,300,400,500,600,700,800,900&display=swap"
      rel="stylesheet"
    >
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat+Alternates:wght@100;200;300;400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    >
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500&display=swap" rel="stylesheet">

    <link rel="stylesheet" href={styles}>

    <script is:inline src={paceUrl}></script>

    <EmDashHead page={pageCtx} />
  </head>
  <body class:list={[pageName && `page-${pageName}`]}>
    <EmDashBodyStart page={pageCtx} />

    <LoadingScreen />

    <Navbar items={menus} offset={navbarOffset} />

    <main>
      <slot />
    </main>

    <Footer
      tel={shopInfo.tel}
      telNo={shopInfo.tel_no}
      contactTime={shopInfo.contact_time}
      address={{
        postalCode: shopInfo.postal_code,
        addressLevel1: shopInfo.address_level1,
        addressLevel2: shopInfo.address_level2,
        addressLine1: shopInfo.address_line1,
        addressLine2: shopInfo.address_line2,
      }}
      url={{
        barSweets: "/cafebar",
        roomGolf: shopInfo.golf_url,
        spaceRental: "/event",
        billiard: "/billiard",
        blog: "/blog",
      }}
      sns={{
        instagram: shopInfo.instagram,
        facebook: shopInfo.facebook,
        line: shopInfo.line,
      }}
    />

    <ScrollToTop />

    <Cursor />

    <script>
    import Splitting from "splitting";
    import WOW from "wow.js";

    Splitting();
    window.addEventListener("load", () => {
      const idle = window.requestIdleCallback ?? ((fn: () => void) => window.setTimeout(fn, 1));
      idle(() => new WOW().init());
    });
    </script>

    <EmDashBodyEnd page={pageCtx} />
  </body>
</html>
